APP_NAME="LMS IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos SQLite (archivo database/database.sqlite)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Las sesiones en base de datos permiten monitorizarlas y forzar el cierre
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo SMTP (códigos OTP de verificación y recuperación de contraseña) ---
# Ejemplo con Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=null y una "contraseña de aplicación".
# Con MAIL_MAILER=log los correos (y los códigos OTP) se escriben en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google Gemini AI (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TIMEOUT=120

# --- Inicio de sesión con Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials) ---
# URI de redirección autorizada: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Ajustes del LMS ---
LMS_MAX_UPLOAD_KB=10240
LMS_MAX_AI_CHARS=60000
LMS_TTS_MAX_CHARS=3000
LMS_BACKUPS_KEEP=14

# Administrador creado por "php artisan db:seed" (¡cámbialo en producción!)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@lms.test
ADMIN_PASSWORD=password
